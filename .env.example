# ===== 认证（强烈建议生产启用；配置后全站需要 Basic Auth 登录）=====
AUTH_USER=yiwei
AUTH_PASS=改成强密码

# ===== 对话 AI（前端 AK 弹窗留空 Key 时使用服务器配置）=====
CHAT_API_KEY=sk-你的key
CHAT_BASE_URL=https://vip.apiyi.com/v1/chat/completions
CHAT_MODEL=grok-4.3

# ===== 翻译 AI（前端 AK 弹窗留空 Key 时使用服务器配置）=====
TRANS_API_KEY=sk-你的key
TRANS_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
TRANS_MODEL=glm-4-flash

# ===== 兼容旧配置（DEEPSEEK_API_KEY 仍可用作对话兜底）=====
# DEEPSEEK_API_KEY=sk-xxx
